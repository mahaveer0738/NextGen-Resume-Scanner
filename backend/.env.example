# ============================================================
#  .env.example
#
#  Rename this file to `.env` and fill in your actual API keys.
#  DO NOT commit your actual `.env` file to GitHub!
# ============================================================

# Google Gemini API Key (Required for heavy parsing and logic)
# Get it here: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for lightning-fast Llama-3 extraction)
# Get it here: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Optional but recommended for Web Research)
# Get it here: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
