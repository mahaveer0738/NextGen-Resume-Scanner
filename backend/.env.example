# ============================================================
#  .env.example — API Keys & Environment Configuration
#  Copy this file to .env and fill in your actual keys.
#  NEVER commit your actual .env file to GitHub!
# ============================================================

# Google Gemini API Key (Required — get free at https://aistudio.google.com)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API Key (Required — get free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Optional — get free at https://tavily.com)
# If not provided, DuckDuckGo is used automatically
TAVILY_API_KEY=your_tavily_api_key_here

# JWT Secret Key — any long random string you choose (e.g. generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random
